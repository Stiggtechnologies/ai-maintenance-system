# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Stripe (publishable key only - secret key goes in Supabase Edge Function secrets)
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Google Analytics (optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Demo credentials (optional - only set for staging/demo environments)
# VITE_DEMO_EMAIL=
# VITE_DEMO_PASSWORD=

# Microsoft Entra SSO is configured server-side in Supabase Auth. Never put
# its client secret (or client id merely for URL construction) in VITE_ vars.
# Local Supabase setup uses SUPABASE_AUTH_EXTERNAL_AZURE_* in config.toml.

# App
VITE_APP_URL=http://localhost:5173
VITE_ENVIRONMENT=development

# Note: Never commit .env files to version control
# For production, set these as environment variables in your hosting platform

# ============================================
# SUPABASE EDGE FUNCTION SECRETS (set via Supabase Dashboard or CLI)
# These are NOT VITE_ prefixed — they run server-side only
# ============================================
# Marketplace publisher service credentials (commerce APIs only):
# AZURE_AD_CLIENT_ID=your_marketplace_publisher_client_id
# AZURE_AD_CLIENT_SECRET=your_marketplace_publisher_client_secret
# AZURE_AD_TENANT_ID=your_marketplace_publisher_tenant_id
# OPENAI_API_KEY=your_server_side_openai_api_key
# PUBLIC_RELIABILITY_MODEL=gpt-5.6-terra
# PUBLIC_RELIABILITY_RATE_LIMIT_SECRET=generate_a_long_random_secret
# ALLOWED_ORIGINS=https://app.syncai.ca,http://localhost:5173
