# SyncAI Production Environment Variables
# Copy to .env.production and fill in values from .credentials-vault.env

# ============================================
# SUPABASE (Get from Supabase Dashboard)
# ============================================
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ============================================
# OPENAI API (Use Axium key from credentials vault)
# ============================================
# NOTE: This should be set in Supabase Edge Function secrets, NOT here
# OPENAI_API_KEY will be accessed server-side only
# Value: OPENAI_API_KEY_AXIUM from .credentials-vault.env

# ============================================
# STRIPE (Use test keys for staging, live for production)
# ============================================
# TEST KEYS (from credentials vault)
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Secret key goes in Supabase Edge Function secrets
# STRIPE_SECRET_KEY (server-side only)
# Value: STRIPE_SECRET_KEY_TEST from .credentials-vault.env

# ============================================
# TWILIO (Optional - for SMS alerts)
# ============================================
# Set in Supabase Edge Function secrets if needed
# TWILIO_API_KEY from .credentials-vault.env

# ============================================
# AZURE AD SSO (Required for Azure Marketplace)
# ============================================
# Register SyncAI as a multi-tenant app, then store ENTRA_SSO_CLIENT_ID and
# ENTRA_SSO_CLIENT_SECRET as GitHub repository secrets. Set ENTRA_SSO_TENANT as
# a repository variable (normally `common`). The protected workflow applies
# these only to hosted Supabase Auth. No Entra credential belongs in VITE_ vars.

# Separate Marketplace publisher credentials go in Supabase Edge Function
# secrets for backend commerce calls only:
# AZURE_MARKETPLACE_CLIENT_ID=your_marketplace_publisher_client_id
# AZURE_MARKETPLACE_CLIENT_SECRET=your_marketplace_publisher_client_secret
# AZURE_MARKETPLACE_TENANT_ID=your_marketplace_publisher_tenant_id
# AZURE_MARKETPLACE_PUBLISHER_ID=your_partner_center_publisher_id
# AZURE_MARKETPLACE_OFFER_ID=your_transactable_saas_offer_id

# ============================================
# DEPLOYMENT
# ============================================
VITE_APP_URL=https://app.syncai.ca
VITE_ENVIRONMENT=production
