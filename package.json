{
  "name": "ai-maintenance-system",
  "private": true,
  "version": "1.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "./scripts/dev-full.sh",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run industry-packs:check && node scripts/check-reliability-baseline.mjs && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "compliance:governance": "node scripts/compliance/check-governance.mjs",
    "reliability:baseline": "vitest run src/test/reliabilityEngineerGoldenBaseline.test.ts supabase/functions/_shared/reliability-engineer-core.test.ts && node scripts/check-reliability-baseline.mjs",
    "reliability:qualify": "tsx scripts/run-reliability-qualification.ts",
    "reliability:dryrun": "tsx scripts/run-reliability-qualification.ts --dry-run --output=/tmp/re-2026-08-dry-run-report.json && tsx scripts/run-reliability-qualification.ts --dry-run --capture-reference --output=/tmp/re-2026-08-dry-run-reference.json",
    "prepare": "husky",
    "register:tally": "node scripts/register-tally.mjs --write",
    "register:check": "node scripts/register-tally.mjs --check && node scripts/register-baseline.mjs --check",
    "register:accept": "node scripts/register-tally.mjs --write && node scripts/register-baseline.mjs --write",
    "industry-packs:generate": "tsx scripts/generate-industry-pack-membership.ts",
    "industry-packs:check": "tsx scripts/generate-industry-pack-membership.ts --check",
    "reliability:requalify": "node scripts/reliability-requalify.mjs",
    "compliance:licenses": "node scripts/compliance/generate-license-inventory.mjs --check",
    "compliance:licenses:write": "node scripts/compliance/generate-license-inventory.mjs --write",
    "compliance:sbom": "npm sbom --sbom-format cyclonedx",
    "compliance:check": "npm run compliance:governance && npm run compliance:licenses"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.112.3",
    "@types/qrcode": "^1.5.6",
    "fflate": "^0.8.3",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.33.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "7.18.2",
    "tesseract.js": "^5.1.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.1.0",
    "postcss": "^8.5.20",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.3",
    "terser": "^5.49.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  }
}
